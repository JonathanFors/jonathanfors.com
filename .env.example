# beehiiv — used by app/api/subscribe to add subscribers server-side, so the
# signup forms finish in place instead of redirecting to beehiiv.
# Create at: beehiiv → Settings → API. Add the same value in Vercel →
# Project → Settings → Environment Variables (all environments).
BEEHIIV_API_KEY=

# Optional. Defaults to the Shuffle Club publication if unset.
BEEHIIV_PUBLICATION_ID=pub_7acd9c66-dec5-40ec-990a-bfd12f0e29e0

# Optional. The beehiiv custom fields the group waitlist writes to — each must
# match a custom field that exists on the publication (beehiiv → Audience →
# Custom fields), name for name. Defaults below.
BEEHIIV_FIRST_NAME_FIELD=First Name
BEEHIIV_EXPERIENCE_FIELD=Experience level
